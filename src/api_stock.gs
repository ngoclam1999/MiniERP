  if(!Array.isArray(lines)||!lines.length)throw apiError('VALIDATION','Cần ít nhất một dòng kiểm kê.','lines');
  lines.forEach(function(value){
    var line=findById('StocktakeLines',value.line_id);if(!line||String(line.kk_id)!==String(id))throw apiError('NOT_FOUND','Không tìm thấy dòng kiểm kê: '+value.line_id);
    var counted=Number(value.qty_counted);if(!Number.isFinite(counted)||counted<0)throw apiError('VALIDATION','Số lượng thực đếm phải là số không âm.','qty_counted');
    var delta=counted-Number(line.qty_book||0),reason=String(value.reason||'').trim(),projectId=String(value.project_id||'').trim();
    if(delta<0&&!reason)throw apiError('VALIDATION','Chênh lệch âm của '+line.sku+' bắt buộc có lý do.','reason');
    if(projectId&&!findById('Projects',projectId))throw apiError('NOT_FOUND','Không tìm thấy dự án: '+projectId,'project_id');
    update('StocktakeLines',line.line_id,{qty_counted:counted,reason:reason,project_id:projectId});
  });
  return getStocktake_(id);
}
function ensureStocktakeCompensationPr_(projectId,sku,qty){
  var pr=query('PR',function(x){return String(x.project_id)===String(projectId)&&String(x.sku)===String(sku)&&String(x.status)==='open';})[0];
  if(pr){update('PR',pr.pr_id,{qty:Math.max(Number(pr.qty||0),Number(qty))});return pr.pr_id;}
  return insert('PR',{pr_id:nextId('PR'),project_id:projectId,sku:sku,qty:Number(qty),need_date:'',status:'open',source:'bom_auto'}).pr_id;
}
function approveStocktake_(id){
  var note=findById('Stocktakes',id);if(!note)throw apiError('NOT_FOUND','Không tìm thấy phiếu kiểm kê: '+id);
  if(String(note.status)!=='counting')throw apiError('INVALID_STATE','Chỉ phiếu đang kiểm mới được duyệt.');
  var lines=query('StocktakeLines',function(x){return String(x.kk_id)===String(id);});
  if(!lines.length||lines.some(function(x){return x.qty_counted===''||x.qty_counted===null||x.qty_counted===undefined;}))throw apiError('VALIDATION','Phải nhập đủ số lượng thực đếm trước khi duyệt.','qty_counted');
  var affected=[];
  lines.forEach(function(line){
    var balance=findBalance_(line.sku,note.wh_id);if(!balance)throw apiError('NOT_FOUND','Không tìm thấy tồn kho cho '+line.sku);
    var delta=Number(line.qty_counted)-Number(line.qty_book||0),after=Number(balance.qty_on_hand||0)+delta,reserved=Number(balance.qty_reserved||0);
    if(after<reserved){
      var remaining=reserved-after;
      query('StockReservations',function(r){return String(r.sku)===String(line.sku)&&String(r.wh_id)===String(note.wh_id)&&String(r.status)==='active';}).forEach(function(r){if(remaining<=0)return;var shortage=Math.min(Number(r.qty||0),remaining);if(shortage>0){affected.push({project_id:r.project_id,sku:line.sku,qty_short:shortage,pr_id:ensureStocktakeCompensationPr_(r.project_id,line.sku,shortage)});remaining-=shortage;}});
    }
  });
  if(affected.length)throw apiError('STOCK_INSUFFICIENT','Chưa thể duyệt vì tồn sau kiểm kê thấp hơn số đã giữ. Đã tạo PR bù cho: '+affected.map(function(x){return x.project_id+' '+x.sku+' ('+x.qty_short+')';}).join(', '));
  lines.forEach(function(line){var delta=Number(line.qty_counted)-Number(line.qty_book||0);if(delta===0)return;var balance=findBalance_(line.sku,note.wh_id);saveBalance_(line.sku,note.wh_id,Number(balance.qty_on_hand)+delta,Number(balance.qty_reserved||0));movement_('adjust',{sku:line.sku,wh_id:note.wh_id,qty:delta,project_id:line.project_id||'',ref_doc:id,note:line.reason||'Kiểm kê'});if(delta<0&&String(line.reason).toLowerCase()==='hư hỏng khi chế tạo'&&line.project_id){var item=findById('Items',line.sku)||{};insert('ProjectCosts',{id:nextId('COST'),project_id:line.project_id,kind:'other',amount_vnd:Math.abs(delta)*Number(item.avg_cost_vnd||0),ref_type:'stocktake',ref_id:id,ts:getDbTimestamp_()});}});
  update('Stocktakes',id,{status:'approved'});return getStocktake_(id);
}
