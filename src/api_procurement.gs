function applyPoLineToBom_(line,direction){var left=Number(line.qty),rows=query('BOM',function(x){return String(x.project_id)===String(line.project_id)&&String(x.sku)===String(line.sku);}).sort(function(a,b){return String(a.need_date).localeCompare(String(b.need_date));});rows.forEach(function(bom){if(left<=0)return;if(direction>0){var capacity=Math.max(0,Number(bom.qty_required||0)-Number(bom.qty_reserved||0)-Number(bom.qty_ordered||0)-Number(bom.qty_issued||0)),take=Math.min(left,capacity);if(take>0){update('BOM',bom.bom_id,{qty_ordered:Number(bom.qty_ordered||0)+take});left-=take;}}else{var remove=Math.min(left,Number(bom.qty_ordered||0));if(remove>0){update('BOM',bom.bom_id,{qty_ordered:Number(bom.qty_ordered||0)-remove});left-=remove;}}});return Number(line.qty)-left;}
