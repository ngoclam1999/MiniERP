function listPr_(filter){var projects={},items={};readAll('Projects').forEach(function(x){projects[String(x.project_id)]=x;});readAll('Items').forEach(function(x){items[String(x.sku)]=x;});var status=String(filter.status||''),projectId=String(filter.project_id||''),search=String(filter.search||'').toLowerCase();return readAll('PR').filter(function(x){return(!status||String(x.status)===status)&&(!projectId||String(x.project_id)===projectId)&&(!search||[x.pr_id,x.project_id,x.sku,(items[String(x.sku)]||{}).name].join(' ').toLowerCase().indexOf(search)>=0);}).map(function(x){var r=copyDbObject_(x);r.project_name=(projects[String(x.project_id)]||{}).name||'';r.item_name=(items[String(x.sku)]||{}).name||'';r.default_sup_id=(items[String(x.sku)]||{}).default_sup_id||'';return r;});}
