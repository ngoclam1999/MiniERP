function updatePo_(id,patch){var po=findById('PO',id);if(!po)throw apiError('NOT_FOUND','Không tìm thấy PO: '+id);if(String(po.status)!=='draft')throw apiError('INVALID_STATE','Chỉ PO nháp mới được sửa.');patch=patch||{};var values={};if(patch.sup_id!==undefined){if(!findById('Suppliers',patch.sup_id))throw apiError('NOT_FOUND','Không tìm thấy nhà cung cấp: '+patch.sup_id,'sup_id');values.sup_id=patch.sup_id;}['order_date','payment_terms','currency'].forEach(function(f){if(patch[f]!==undefined)values[f]=String(patch[f]);});var orderDate=String(values.order_date||po.order_date);if(patch.lines!==undefined){if(!Array.isArray(patch.lines)||!patch.lines.length)throw apiError('VALIDATION','PO cần ít nhất một dòng.','lines');var old=query('POLines',function(x){return String(x.po_id)===String(id);}),byId={};old.forEach(function(x){byId[String(x.line_id)]=x;});var normalized=patch.lines.map(function(x){var current=byId[String(x.line_id)];if(!current)throw apiError('NOT_FOUND','Không tìm thấy dòng PO: '+x.line_id);var merged=copyDbObject_(current);Object.keys(x).forEach(function(key){merged[key]=x[key];});var n=applyCalculatedEta_(normalizePoLine_(merged),orderDate);n.line_id=x.line_id;n.po_id=id;return n;});normalized.forEach(function(x){update('POLines',x.line_id,x);});values.total_vnd=normalized.reduce(function(s,x){return s+x.qty*x.unit_price_vnd;},0);}else if(values.order_date!==undefined){query('POLines',function(x){return String(x.po_id)===String(id)&&String(x.eta_source||'calculated')!=='manual';}).forEach(function(x){update('POLines',x.line_id,applyCalculatedEta_(copyDbObject_(x),orderDate));});}update('PO',id,values);return getPo_(id);}
function listEta_(filter){var projectId=String(filter.project_id||''),status=String(filter.status||''),search=String(filter.search||'').toLowerCase(),today=String(filter.today||Utilities.formatDate(new Date(),'Asia/Bangkok','yyyy-MM-dd')),setting=findById('Settings','alert_soon_days'),soonDays=Number(setting&&setting.value||7),poById={},items={},projects={};readAll('PO').forEach(function(x){poById[String(x.po_id)]=x;});readAll('Items').forEach(function(x){items[String(x.sku)]=x;});readAll('Projects').forEach(function(x){projects[String(x.project_id)]=x;});return readAll('POLines').filter(function(x){var po=poById[String(x.po_id)];return po&&String(po.status)!=='cancelled'&&(!projectId||String(x.project_id)===projectId)&&(!status||String(po.status)===status)&&(!search||[x.line_id,x.po_id,x.sku,(items[String(x.sku)]||{}).name,(projects[String(x.project_id)]||{}).name].join(' ').toLowerCase().indexOf(search)>=0);}).map(function(x){var r=copyDbObject_(x),po=poById[String(x.po_id)],received=Number(x.qty_received||0)>=Number(x.qty||0),daysToNeed=dateDiffDays_(x.eta_date,x.need_date);r.order_date=po.order_date;r.po_status=po.status;r.item_name=(items[String(x.sku)]||{}).name||'';r.project_name=(projects[String(x.project_id)]||{}).name||'';r.eta_state=received?'received':daysToNeed<0?'late':daysToNeed<=soonDays?'soon':'on_track';r.late_days=daysToNeed<0?Math.abs(daysToNeed):0;r.is_past_eta=!received&&String(x.eta_date)<today;return r;});}
function dateDiffDays_(fromDate,toDate){if(!/^\d{4}-\d{2}-\d{2}$/.test(String(fromDate||''))||!/^\d{4}-\d{2}-\d{2}$/.test(String(toDate||'')))return Number.POSITIVE_INFINITY;return Math.round((Date.parse(toDate+'T00:00:00Z')-Date.parse(fromDate+'T00:00:00Z'))/86400000);}
function updateEta_(lineId,etaDate,note){var line=findById('POLines',lineId);if(!line)throw apiError('NOT_FOUND','Không tìm thấy dòng PO: '+lineId,'line_id');var po=findById('PO',line.po_id);if(!po||String(po.status)==='cancelled'||String(po.status)==='received'||Number(line.qty_received||0)>=Number(line.qty||0))throw apiError('INVALID_STATE','Không thể sửa ETA của dòng đã huỷ hoặc đã nhận đủ.');if(!/^\d{4}-\d{2}-\d{2}$/.test(String(etaDate||'')))throw apiError('VALIDATION','ETA phải là ngày hợp lệ.','eta_date');if(!String(note||'').trim())throw apiError('VALIDATION','Bắt buộc nhập lý do khi sửa ETA.','note');return update('POLines',lineId,{eta_date:String(etaDate),eta_source:'manual',eta_note:String(note).trim()});}
function buildPayableRows_(po){var terms=String(po.payment_terms||'').trim(),total=Number(po.total_vnd||0),deposit=terms.match(/^Cọc\s+(\d+(?:[.,]\d+)?)%,\s*còn lại\s+net\s+(\d+)$/i),net=terms.match(/^Net\s+(\d+)$/i),rows=[];if(!(total>=0))throw apiError('VALIDATION','Tổng tiền PO không hợp lệ.','total_vnd');if(deposit){var percent=Number(deposit[1].replace(',','.')),days=Number(deposit[2]);if(!(percent>0&&percent<100))throw apiError('VALIDATION','Tỷ lệ cọc phải lớn hơn 0 và nhỏ hơn 100%.','payment_terms');var first=Math.round(total*percent/100);rows=[{ap_id:po.po_id+'-AP-1',sup_id:po.sup_id,ref:'Cọc '+percent+'%',po_id:po.po_id,amount_vnd:first,due_date:po.order_date,paid_vnd:0},{ap_id:po.po_id+'-AP-2',sup_id:po.sup_id,ref:'Còn lại net '+days,po_id:po.po_id,amount_vnd:total-first,due_date:addDaysToDate_(po.order_date,days),paid_vnd:0}];}else if(net){var netDays=Number(net[1]);rows=[{ap_id:po.po_id+'-AP-1',sup_id:po.sup_id,ref:'Thanh toán 100% · net '+netDays,po_id:po.po_id,amount_vnd:total,due_date:addDaysToDate_(po.order_date,netDays),paid_vnd:0}];}else{throw apiError('VALIDATION','Điều khoản thanh toán chỉ hỗ trợ "Net N" hoặc "Cọc X%, còn lại net N".','payment_terms');}return rows;}
function createPayablesForPo_(po){var existing=query('Payables',function(x){return String(x.po_id)===String(po.po_id);});if(existing.length)return existing;var rows=buildPayableRows_(po);return insertMany('Payables',rows);}
function cancelPayablesForPo_(poId){query('Payables',function(x){return String(x.po_id)===String(poId);}).forEach(function(x){if(Number(x.paid_vnd||0)>0)throw apiError('INVALID_STATE','Không thể huỷ PO đã có công nợ được thanh toán.');softDelete('Payables',x.ap_id);});}
function formatPoMoney_(value){return Math.round(Number(value||0)).toLocaleString('vi-VN')+' VND';}
function exportPoPdf_(id){var po=getPo_(id),supplier=findById('Suppliers',po.sup_id)||{},doc=DocumentApp.create('PO '+po.po_id),body=doc.getBody();body.appendParagraph('ĐƠN MUA HÀNG').setHeading(DocumentApp.ParagraphHeading.HEADING1);body.appendParagraph('Mã PO: '+po.po_id);body.appendParagraph('Ngày đặt: '+po.order_date);body.appendParagraph('Nhà cung cấp: '+String(supplier.name||po.sup_id));body.appendParagraph('Điều khoản thanh toán: '+String(po.payment_terms||''));var table=[['SKU','Dự án','Số lượng','Đơn giá','Thành tiền','ETA']];po.lines.forEach(function(x){table.push([String(x.sku),String(x.project_id),String(x.qty),formatPoMoney_(x.unit_price_vnd),formatPoMoney_(Number(x.qty)*Number(x.unit_price_vnd)),String(x.eta_date||'')]);});body.appendTable(table);body.appendParagraph('TỔNG CỘNG: '+formatPoMoney_(po.total_vnd)).setHeading(DocumentApp.ParagraphHeading.HEADING2);doc.saveAndClose();var source=DriveApp.getFileById(doc.getId()),blob=source.getBlob().getAs('application/pdf').setName('PO-'+po.po_id+'.pdf'),pdf=DriveApp.createFile(blob);source.setTrashed(true);return{file_id:pdf.getId(),name:pdf.getName(),url:pdf.getUrl()};}
