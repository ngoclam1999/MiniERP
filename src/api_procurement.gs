function addDaysToDate_(dateText,days){if(!/^\d{4}-\d{2}-\d{2}$/.test(String(dateText||'')))throw apiError('VALIDATION','Ngày đặt hàng không hợp lệ.','order_date');var parts=String(dateText).split('-').map(Number),date=new Date(Date.UTC(parts[0],parts[1]-1,parts[2]));date.setUTCDate(date.getUTCDate()+Number(days||0));return date.toISOString().slice(0,10);}
function applyCalculatedEta_(line,orderDate){if(String(line.eta_source||'')==='manual'&&line.eta_date)return line;line.eta_date=addDaysToDate_(orderDate,line.lead_time_days);line.eta_source='calculated';line.eta_note='';return line;}
function createPo_(p){if(!p||!findById('Suppliers',p.sup_id))throw apiError('NOT_FOUND','Không tìm thấy nhà cung cấp: '+(p&&p.sup_id),'sup_id');var supplier=findById('Suppliers',p.sup_id),source=p.pr_rows||p.lines;if(!Array.isArray(source)||!source.length)throw apiError('VALIDATION','PO cần ít nhất một dòng.','lines');var orderDate=String(p.order_date||getDbTimestamp_()).slice(0,10),lines=source.map(function(x){return applyCalculatedEta_(normalizePoLine_({sku:x.sku,project_id:x.project_id,pr_id:x.pr_id||'',qty:x.qty,unit_price_vnd:x.unit_price_vnd,lead_time_days:x.lead_time_days,eta_date:x.eta_date,eta_source:x.eta_source,eta_note:x.eta_note,need_date:x.need_date,qty_received:x.qty_received}),orderDate);});var id=nextId('PO'),total=lines.reduce(function(s,x){return s+x.qty*x.unit_price_vnd;},0),po=insert('PO',{po_id:id,sup_id:p.sup_id,order_date:orderDate,payment_terms:String(p.payment_terms||supplier.payment_terms||''),currency:String(p.currency||'VND'),status:'draft',total_vnd:total});insertMany('POLines',lines.map(function(x,i){x.line_id=id+'-'+(i+1);x.po_id=id;return x;}));lines.forEach(function(x){if(x.pr_id)update('PR',x.pr_id,{status:'po_created'});});return getPo_(id);}
