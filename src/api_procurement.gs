var MINI_ERP_PO_STATUSES=['draft','sent','confirmed','in_transit','partial','received','cancelled'];
function registerProcurementActions_(){
  registerActionOnce_('pr.list',function(p){requireRole(getAuthContext_(),['director','manager','engineer','purchasing','warehouse','accountant']);return listPr_(p||{});},false);
  registerActionOnce_('pr.create_manual',function(p){requireRole(getAuthContext_(),['purchasing']);return createManualPr_(p);},true);
  registerActionOnce_('pr.cancel',function(p){requireRole(getAuthContext_(),['purchasing']);return cancelPr_(p&&p.pr_id);},true);
  registerActionOnce_('pr.to_po',function(p){requireRole(getAuthContext_(),['purchasing']);return prToPo_(p&&p.pr_ids,p&&p.sup_id);},true);
  registerActionOnce_('po.create',function(p){requireRole(getAuthContext_(),['purchasing']);return createPo_(p);},true);
  registerActionOnce_('po.update',function(p){requireRole(getAuthContext_(),['purchasing']);return updatePo_(p&&p.po_id,p&&p.patch);},true);
  registerActionOnce_('po.send',function(p){requireRole(getAuthContext_(),['purchasing']);return transitionPo_(p&&p.po_id,'sent');},true);
  registerActionOnce_('po.confirm',function(p){requireRole(getAuthContext_(),['purchasing']);return confirmPo_(p&&p.po_id);},true);
  registerActionOnce_('po.cancel',function(p){requireRole(getAuthContext_(),['purchasing']);return cancelPo_(p&&p.po_id);},true);
  registerActionOnce_('po.get',function(p){requireRole(getAuthContext_(),['director','manager','engineer','purchasing','warehouse','accountant']);return getPo_(p&&p.po_id);},false);
  registerActionOnce_('po.list',function(p){requireRole(getAuthContext_(),['director','manager','engineer','purchasing','warehouse','accountant']);return listPo_(p||{});},false);
}
function listPr_(filter){var projects={},items={};readAll('Projects').forEach(function(x){projects[String(x.project_id)]=x;});readAll('Items').forEach(function(x){items[String(x.sku)]=x;});var status=String(filter.status||''),projectId=String(filter.project_id||''),search=String(filter.search||'').toLowerCase();return readAll('PR').filter(function(x){return(!status||String(x.status)===status)&&(!projectId||String(x.project_id)===projectId)&&(!search||[x.pr_id,x.project_id,x.sku,(items[String(x.sku)]||{}).name].join(' ').toLowerCase().indexOf(search)>=0);}).map(function(x){var r=copyDbObject_(x);r.project_name=(projects[String(x.project_id)]||{}).name||'';r.item_name=(items[String(x.sku)]||{}).name||'';r.default_sup_id=(items[String(x.sku)]||{}).default_sup_id||'';return r;});}
function createManualPr_(p){if(!p||!p.project_id||!p.sku||!(Number(p.qty)>0)||!/^\d{4}-\d{2}-\d{2}$/.test(String(p.need_date||'')))throw apiError('VALIDATION','PR cần dự án, vật tư, số lượng dương và ngày cần hợp lệ.');if(!findById('Projects',p.project_id))throw apiError('NOT_FOUND','Không tìm thấy dự án: '+p.project_id,'project_id');if(!findById('Items',p.sku))throw apiError('NOT_FOUND','Không tìm thấy SKU: '+p.sku,'sku');return insert('PR',{pr_id:nextId('PR'),project_id:p.project_id,sku:p.sku,qty:Number(p.qty),need_date:String(p.need_date),status:'open',source:'manual'});}
function cancelPr_(id){var pr=findById('PR',id);if(!pr)throw apiError('NOT_FOUND','Không tìm thấy PR: '+id);if(String(pr.status)!=='open')throw apiError('INVALID_STATE','Chỉ PR đang mở mới được huỷ.');return update('PR',id,{status:'cancelled'});}
function prToPo_(ids,supId){if(!Array.isArray(ids)||!ids.length)throw apiError('VALIDATION','Hãy chọn ít nhất một PR.','pr_ids');if(!findById('Suppliers',supId))throw apiError('NOT_FOUND','Không tìm thấy nhà cung cấp: '+supId,'sup_id');var unique={},prs=ids.map(function(id){if(unique[id])throw apiError('VALIDATION','Danh sách PR bị trùng: '+id,'pr_ids');unique[id]=true;var pr=findById('PR',id);if(!pr)throw apiError('NOT_FOUND','Không tìm thấy PR: '+id);if(String(pr.status)!=='open')throw apiError('INVALID_STATE','PR '+id+' không còn ở trạng thái mở.');return pr;});return createPo_({sup_id:supId,pr_rows:prs});}
function normalizePoLine_(line){var item=findById('Items',line&&line.sku);if(!item)throw apiError('NOT_FOUND','Không tìm thấy SKU: '+(line&&line.sku),'sku');var qty=Number(line.qty),price=line.unit_price_vnd===''||line.unit_price_vnd===undefined?Number(item.avg_cost_vnd||0):Number(line.unit_price_vnd),lead=line.lead_time_days===''||line.lead_time_days===undefined?Number(item.lead_time_days||0):Number(line.lead_time_days);if(!(qty>0))throw apiError('VALIDATION','Số lượng dòng PO phải lớn hơn 0.','qty');if(!(price>=0))throw apiError('VALIDATION','Đơn giá phải là số không âm.','unit_price_vnd');if(!(lead>=0)&&Number.isFinite(lead))throw apiError('VALIDATION','Lead-time phải là số không âm.','lead_time_days');if(!Number.isFinite(lead)||lead<0)throw apiError('VALIDATION','Lead-time phải là số không âm.','lead_time_days');return{sku:line.sku,project_id:String(line.project_id||''),pr_id:String(line.pr_id||''),qty:qty,unit_price_vnd:price,lead_time_days:lead,eta_date:String(line.eta_date||''),need_date:String(line.need_date||''),qty_received:Number(line.qty_received||0)};}
function createPo_(p){if(!p||!findById('Suppliers',p.sup_id))throw apiError('NOT_FOUND','Không tìm thấy nhà cung cấp: '+(p&&p.sup_id),'sup_id');var supplier=findById('Suppliers',p.sup_id),source=p.pr_rows||p.lines;if(!Array.isArray(source)||!source.length)throw apiError('VALIDATION','PO cần ít nhất một dòng.','lines');var lines=source.map(function(x){return normalizePoLine_({sku:x.sku,project_id:x.project_id,pr_id:x.pr_id||'',qty:x.qty,unit_price_vnd:x.unit_price_vnd,lead_time_days:x.lead_time_days,eta_date:x.eta_date,need_date:x.need_date,qty_received:x.qty_received});});var id=nextId('PO'),total=lines.reduce(function(s,x){return s+x.qty*x.unit_price_vnd;},0),po=insert('PO',{po_id:id,sup_id:p.sup_id,order_date:String(p.order_date||getDbTimestamp_()).slice(0,10),payment_terms:String(p.payment_terms||supplier.payment_terms||''),currency:String(p.currency||'VND'),status:'draft',total_vnd:total});insertMany('POLines',lines.map(function(x,i){x.line_id=id+'-'+(i+1);x.po_id=id;return x;}));lines.forEach(function(x){if(x.pr_id)update('PR',x.pr_id,{status:'po_created'});});return getPo_(id);}
function getPo_(id){var po=findById('PO',id);if(!po)throw apiError('NOT_FOUND','Không tìm thấy PO: '+id);var r=copyDbObject_(po),supplier=findById('Suppliers',po.sup_id);r.supplier_name=supplier?supplier.name:'';r.lines=query('POLines',function(x){return String(x.po_id)===String(id);});return r;}
function listPo_(filter){var status=String(filter.status||''),search=String(filter.search||'').toLowerCase();return readAll('PO').filter(function(x){var supplier=findById('Suppliers',x.sup_id)||{};return(!status||String(x.status)===status)&&(!search||[x.po_id,x.sup_id,supplier.name].join(' ').toLowerCase().indexOf(search)>=0);}).map(function(x){return getPo_(x.po_id);});}
function updatePo_(id,patch){var po=findById('PO',id);if(!po)throw apiError('NOT_FOUND','Không tìm thấy PO: '+id);if(String(po.status)!=='draft')throw apiError('INVALID_STATE','Chỉ PO nháp mới được sửa.');patch=patch||{};var values={};if(patch.sup_id!==undefined){if(!findById('Suppliers',patch.sup_id))throw apiError('NOT_FOUND','Không tìm thấy nhà cung cấp: '+patch.sup_id,'sup_id');values.sup_id=patch.sup_id;}['order_date','payment_terms','currency'].forEach(function(f){if(patch[f]!==undefined)values[f]=String(patch[f]);});if(patch.lines!==undefined){if(!Array.isArray(patch.lines)||!patch.lines.length)throw apiError('VALIDATION','PO cần ít nhất một dòng.','lines');var old=query('POLines',function(x){return String(x.po_id)===String(id);}),byId={};old.forEach(function(x){byId[String(x.line_id)]=x;});var normalized=patch.lines.map(function(x){if(!byId[String(x.line_id)])throw apiError('NOT_FOUND','Không tìm thấy dòng PO: '+x.line_id);var n=normalizePoLine_(x);n.line_id=x.line_id;n.po_id=id;return n;});normalized.forEach(function(x){update('POLines',x.line_id,x);});values.total_vnd=normalized.reduce(function(s,x){return s+x.qty*x.unit_price_vnd;},0);}update('PO',id,values);return getPo_(id);}
function transitionPo_(id,next){var po=findById('PO',id);if(!po)throw apiError('NOT_FOUND','Không tìm thấy PO: '+id);var allowed={draft:'sent',sent:'confirmed',confirmed:'in_transit',in_transit:'partial',partial:'received'};if(allowed[String(po.status)]!==next)throw apiError('INVALID_STATE','Không thể chuyển PO từ '+po.status+' sang '+next+'.');update('PO',id,{status:next});return getPo_(id);}
function applyPoLineToBom_(line,direction){var left=Number(line.qty),rows=query('BOM',function(x){return String(x.project_id)===String(line.project_id)&&String(x.sku)===String(line.sku);}).sort(function(a,b){return String(a.need_date).localeCompare(String(b.need_date));});rows.forEach(function(bom){if(left<=0)return;if(direction>0){var capacity=Math.max(0,Number(bom.qty_required||0)-Number(bom.qty_reserved||0)-Number(bom.qty_ordered||0)-Number(bom.qty_issued||0)),take=Math.min(left,capacity);if(take>0){update('BOM',bom.bom_id,{qty_ordered:Number(bom.qty_ordered||0)+take});left-=take;}}else{var remove=Math.min(left,Number(bom.qty_ordered||0));if(remove>0){update('BOM',bom.bom_id,{qty_ordered:Number(bom.qty_ordered||0)-remove});left-=remove;}}});return Number(line.qty)-left;}
function confirmPo_(id){var po=findById('PO',id);if(!po)throw apiError('NOT_FOUND','Không tìm thấy PO: '+id);if(String(po.status)!=='sent')throw apiError('INVALID_STATE','Chỉ PO đã gửi mới được xác nhận.');query('POLines',function(x){return String(x.po_id)===String(id);}).forEach(function(line){applyPoLineToBom_(line,1);});update('PO',id,{status:'confirmed'});return getPo_(id);}
function cancelPo_(id){var po=findById('PO',id);if(!po)throw apiError('NOT_FOUND','Không tìm thấy PO: '+id);if(['draft','sent','confirmed'].indexOf(String(po.status))<0)throw apiError('INVALID_STATE','Chỉ PO nháp, đã gửi hoặc đã xác nhận mới được huỷ.');var lines=query('POLines',function(x){return String(x.po_id)===String(id);});if(String(po.status)==='confirmed')lines.forEach(function(line){applyPoLineToBom_(line,-1);});lines.forEach(function(line){if(line.pr_id){var pr=findById('PR',line.pr_id);if(pr&&String(pr.status)==='po_created')update('PR',line.pr_id,{status:'open'});}});update('PO',id,{status:'cancelled'});return getPo_(id);}
