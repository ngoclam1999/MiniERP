function cancelPr_(id){var pr=findById('PR',id);if(!pr)throw apiError('NOT_FOUND','Không tìm thấy PR: '+id);if(String(pr.status)!=='open')throw apiError('INVALID_STATE','Chỉ PR đang mở mới được huỷ.');return update('PR',id,{status:'cancelled'});}
